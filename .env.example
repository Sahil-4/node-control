ADMIN_USER=admin
ADMIN_PASS=securepassword
ALLOW_REBOOT=false
PORT=3000
# ALLOWED_SCOPE=/home/user   # Directory LS and file viewer are restricted to. Defaults to the project root.
# FILE_GUARD=false            # Set to false to disable sensitive filename blocking (blocks passwd, .env, secret, config, etc. by default).
# MONITOR_INTERVAL_MS=2000   # Monitor refresh interval in milliseconds (min 500, max 60000, default 2000).
# LANDING_PAGE=monitor        # Page shown after login (monitor, notes, files, system, clipboard). Default: monitor.
# MAX_UPLOAD_MB=50            # Max file upload size in MB. Default: 50.
